{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lacrm-mcp-remote",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // nodejs_compat: agents/mcp/server uses AsyncLocalStorage.
  // global_fetch_strictly_public: SSRF protection for Client ID Metadata Document fetches.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Public URL on our own domain; workers.dev disabled so the account subdomain is not exposed.
  "workers_dev": false,
  "routes": [{ "pattern": "lacrm-mcp.northkeellabs.com", "custom_domain": true }],
  "vars": {
    // The URL MCP clients connect to; every token is bound to it.
    // Production value for the hosted instance. Self-hosting: see README "Deploy your own". Local dev: .dev.vars overrides it.
    "MCP_RESOURCE": "https://lacrm-mcp.northkeellabs.com/mcp",
    "RATE_LIMIT_PER_MINUTE": "60"
  },
  "kv_namespaces": [
    // Create with: npx wrangler kv namespace create OAUTH_KV  (then paste the id here)
    { "binding": "OAUTH_KV", "id": "b3d39116c6fc4f1885e0f92de73b2372" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
  },
  // SQLite-backed Durable Objects work on the Workers free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }]
}
